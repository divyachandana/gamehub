# Copy this file to .env and fill it in.

# Which backend runs the models: claude | ollama | mock
#   claude = Anthropic API (needs ANTHROPIC_API_KEY)
#   ollama = local models via Ollama (Gemma, your fast model, etc.)
#   mock   = scripted answers, no AI at all (for UI testing / demo backup)
PROVIDER=claude

# ---- Claude ----
ANTHROPIC_API_KEY=
# BIG_MODEL=claude-opus-5-5     # plays the suspect
# FAST_MODEL=claude-haiku-5-5   # note-taker: extracts places/times + stress

# ---- Ollama (local) ----
# PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# BIG_MODEL=gemma3:4b
# FAST_MODEL=your-fast-model    # e.g. the System 1 / Laya model

# ---- Mix and match (optional) ----
# Run each brain on a different backend, e.g. Gemma for the suspect + Claude for notes:
# BIG_PROVIDER=ollama
# FAST_PROVIDER=claude

# PORT=3000
# CASE=union-square-heist
