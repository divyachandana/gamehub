diff --git a/examples/qualcomm/oss_scripts/llama/qnn_llm_host.cpp b/examples/qualcomm/oss_scripts/llama/qnn_llm_host.cpp
new file mode 100644
index 0000000000..4b2ab064f4
--- /dev/null
+++ b/examples/qualcomm/oss_scripts/llama/qnn_llm_host.cpp
@@ -0,0 +1,464 @@
+/*
